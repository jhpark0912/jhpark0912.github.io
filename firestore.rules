rules_version = '2';

// Publish from the Firebase console: Firestore Database -> Rules -> Publish.
//
// This belongs in the FIRESTORE rules editor. Realtime Database is a separate
// product whose rules are JSON; pasting this file there fails with
// "Line 1: Parse error" because it expects an opening brace.
//
// Two kinds of writer:
//
//   Guests are signed in anonymously. Their uid is stamped on each document and
//   that is what gates deletion, so a guest can remove their own message and no
//   one else's.
//
//   Admins are real accounts listed in the `admins` collection - one document
//   per uid, added by hand in the console. Membership lives in data rather than
//   in these rules, so adding or removing an admin never means editing and
//   re-publishing rules. Admins may delete any message and are the only ones
//   who can read the RSVP responses.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // exists() is evaluated server-side and ignores the rules below, so the
    // admins collection can stay completely unreadable from the client.
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /guestbook/{entryId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['name', 'message', 'createdAt', 'ownerId'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 300
        && request.resource.data.createdAt is number;

      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);

      // Messages are never edited in place - delete and write a new one.
      allow update: if false;
    }

    match /rsvp/{responseId} {
      // Responses carry names and phone numbers, so only an admin may read
      // them back. The invitation itself never reads this collection.
      allow read: if isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.attending is bool
        && request.resource.data.headcount is int
        && request.resource.data.headcount >= 0
        && request.resource.data.headcount <= 10;

      allow delete: if isAdmin();
      allow update: if false;
    }

    // The invitation's own content: what it says, which photos it shows and in
    // what order the sections run.
    //
    //   site/published  what guests see. Read by everyone, written by admins.
    //   site/draft      what the admin page is editing. Admins only, both ways.
    //
    // Splitting them is what lets someone edit the invitation while guests are
    // reading it: nothing they type is visible until they publish, which copies
    // the draft over the published document.
    match /site/{slot} {
      allow read: if slot == 'published' || isAdmin();
      allow write: if isAdmin() && (slot == 'published' || slot == 'draft');
    }

    // Uploaded photos, one document each, holding a JPEG data URL.
    //
    // There is no Storage bucket in this project, so the bytes live here. The
    // size limit is the important rule: a Firestore document may not exceed
    // 1 MiB, and the admin page shrinks every photo well below that before
    // writing it. The check is repeated here because the browser doing the
    // shrinking is not what enforces anything.
    match /photos/{photoId} {
      allow read: if true;

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['data', 'width', 'height', 'createdAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() > 0
        && request.resource.data.data.size() <= 400000
        && request.resource.data.width is int
        && request.resource.data.height is int
        && request.resource.data.createdAt is number;

      allow delete: if isAdmin();

      // A photo is written once. Replacing one means uploading a new document
      // and pointing the gallery at it, which keeps the published invitation
      // working until the moment it is republished.
      allow update: if false;
    }

    // The allowlist itself is console-only. Nothing on the web may read it -
    // which also means nobody can enumerate who the admins are - and nothing
    // may write it, so an admin cannot promote anyone.
    match /admins/{uid} {
      allow read, write: if false;
    }
  }
}
