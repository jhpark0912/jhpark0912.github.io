# Copy to `.env` for local development. In production these are injected by the
# GitHub Actions workflow from repository secrets of the same name.
#
# All VITE_* values are compiled into the published JavaScript and are therefore
# public. That is expected for these keys — they are restricted by domain
# (Kakao) and by security rules (Firebase), not by secrecy.

# Kakao Developers → 내 애플리케이션 → 앱 키 → JavaScript 키
# Register https://jhpark0912.github.io under 플랫폼 → Web → 사이트 도메인.
# Used by both the venue map and the KakaoTalk share button.
VITE_KAKAO_JS_KEY=

# Firebase console → 프로젝트 설정 → 내 앱 → SDK 설정 및 구성
# Leave blank to run the guestbook and RSVP against the in-browser mock store.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
